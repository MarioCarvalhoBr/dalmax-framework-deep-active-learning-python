{
    "DANINHAS": {
        "data_dir": "DATA/daninhas_micro/",
        "n_epoch": 1,
        "n_drop": 10,
        "n_classes": 5,
        "train_args": {
            "batch_size": 16,
            "num_workers": 0
        },
        "test_args": {
            "batch_size": 16,
            "num_workers": 0
        },
        "optimizer_args": {
            "lr": 0.05,
            "momentum": 0.3
        },
        "embedding": {
            "extractor": "vctex",
            "q": [
                5
            ],
            "variant": "full"
        },
        "selection": {
            "method": "hierarchical",
            "hierarchy": {
                "_comment": "Micro-scaled analog of params_df_gpu_0.json's config_kmh reference hierarchy ([600,200,100]/[30,15,2]), same 3-level shape, sized for the ~796-image daninhas_micro unlabeled pool (806 train - 10 initial labeled).",
                "n_clusters": [
                    60,
                    20,
                    10
                ],
                "n_levels": 3,
                "sample_sizes": [
                    3,
                    2,
                    2
                ]
            }
        }
    }
}
