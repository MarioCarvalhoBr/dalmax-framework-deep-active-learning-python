{
    "DANINHAS": {
        "data_dir": "DATA/daninhas_full/",
        "n_epoch": 10,
        "n_drop": 10,
        "n_classes": 5,
        "train_args": {
            "batch_size": 256,
            "num_workers": 4
        },
        "test_args": {
            "batch_size": 256,
            "num_workers": 4
        },
        "optimizer_args": {
            "lr": 0.05,
            "momentum": 0.3
        },
        "embedding": {
            "extractor": "vctex",
            "q": [
                5,
                17
            ],
            "variant": "full"
        },
        "selection": {
            "method": "flat_proportional"
        }
    }
}
